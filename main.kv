#:import dp kivy.metrics.dp
#:import sp kivy.metrics.sp

<MainScreen>:
    name: 'main'
    canvas.before:
        Color:
            rgba: 0.07, 0.08, 0.12, 1
        Rectangle:
            pos: self.pos
            size: self.size

    BoxLayout:
        orientation: 'vertical'
        padding: dp(15)
        spacing: dp(15)

        # Top Bar
        BoxLayout:
            size_hint_y: None
            height: dp(50)
            Label:
                text: "Metal Serial Scanner"
                font_size: sp(20)
                bold: True
                color: 0.2, 0.85, 1, 1
            Button:
                text: "History"
                size_hint_x: None
                width: dp(100)
                background_normal: ''
                background_color: 0.15, 0.2, 0.3, 1
                color: 0.8, 0.8, 0.8, 1
                on_press: app.go_to_history()

        # Image Preview Area
        FloatLayout:
            size_hint_y: 0.4
            canvas.before:
                Color:
                    rgba: 0.12, 0.13, 0.18, 1
                RoundedRectangle:
                    pos: self.pos
                    size: self.size
                    radius: [dp(15)]
            
            Image:
                id: preview_image
                pos: self.parent.pos
                size: self.parent.size
                fit_mode: "contain"

            Label:
                id: no_image_label
                pos: self.parent.pos
                size: self.parent.size
                text: "Upload or Capture an Image"
                color: 0.4, 0.45, 0.55, 1
                font_size: sp(16)

        # Action Buttons
        BoxLayout:
            size_hint_y: None
            height: dp(50)
            spacing: dp(10)
            Button:
                text: "Upload Image"
                background_normal: ''
                background_color: 0.2, 0.6, 1, 1
                bold: True
                on_press: app.open_file_picker()
            Button:
                text: "Camera"
                background_normal: ''
                background_color: 0.15, 0.65, 0.45, 1
                bold: True
                on_press: app.open_camera()
            Button:
                id: scan_btn
                text: "SCAN NUMBER"
                background_normal: ''
                background_color: 0.8, 0.2, 0.2, 1
                bold: True
                on_press: app.run_ocr()

        # Status line (what the app is doing right now)
        Label:
            id: status_label
            text: "Select or capture an image to begin"
            size_hint_y: None
            height: dp(22)
            font_size: sp(12)
            color: 0.55, 0.6, 0.72, 1

        # Results Panel
        BoxLayout:
            size_hint_y: 0.35
            orientation: 'vertical'
            spacing: dp(10)
            canvas.before:
                Color:
                    rgba: 0.1, 0.11, 0.16, 1
                RoundedRectangle:
                    pos: self.pos
                    size: self.size
                    radius: [dp(15)]
            
            BoxLayout:
                size_hint_y: None
                height: dp(40)
                Label:
                    id: result_number
                    text: "---"
                    font_size: sp(28)
                    bold: True
                    color: 0.2, 0.9, 0.55, 1
                Button:
                    text: "Copy"
                    size_hint_x: None
                    width: dp(80)
                    background_normal: ''
                    background_color: 0.3, 0.3, 0.4, 1
                    on_press: app.copy_number()

            BoxLayout:
                size_hint_y: None
                height: dp(30)
                Label:
                    id: engine_label
                    text: "Engine: -"
                    font_size: sp(12)
                    color: 0.6, 0.6, 0.7, 1
                Label:
                    id: confidence_label
                    text: "0%"
                    font_size: sp(14)
                    bold: True
                    color: 0.9, 0.8, 0.2, 1
            
            ProgressBar:
                id: confidence_bar
                max: 100
                value: 0
                size_hint_y: None
                height: dp(10)
            
            BoxLayout:
                size_hint_y: None
                height: dp(30)
                Label:
                    text: "Suggestions:"
                    size_hint_x: None
                    width: dp(100)
                    font_size: sp(12)
                    color: 0.5, 0.5, 0.6, 1
                ScrollView:
                    do_scroll_y: False
                    BoxLayout:
                        id: suggestions_chips
                        size_hint_x: None
                        width: self.minimum_width
                        spacing: dp(5)
                        padding: [0, dp(5)]

        # Comparison / Bottom Bar
        BoxLayout:
            size_hint_y: None
            height: dp(40)
            spacing: dp(10)
            Label:
                id: alt1_result
                text: "---"
                font_size: sp(12)
                color: 0.5, 0.7, 1, 1
                canvas.before:
                    Color:
                        rgba: 0.15, 0.18, 0.25, 1
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [dp(8)]
            Label:
                id: alt2_result
                text: "---"
                font_size: sp(12)
                color: 0.5, 0.7, 1, 1
                canvas.before:
                    Color:
                        rgba: 0.15, 0.18, 0.25, 1
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [dp(8)]

<HistoryScreen>:
    name: 'history'
    canvas.before:
        Color:
            rgba: 0.07, 0.08, 0.12, 1
        Rectangle:
            pos: self.pos
            size: self.size

    BoxLayout:
        orientation: 'vertical'
        padding: dp(15)
        spacing: dp(15)

        # Top Bar
        BoxLayout:
            size_hint_y: None
            height: dp(50)
            Button:
                text: "< Back"
                size_hint_x: None
                width: dp(80)
                background_normal: ''
                background_color: 0.3, 0.3, 0.4, 1
                on_press: app.go_to_main()
            Label:
                text: "Scan History"
                font_size: sp(20)
                bold: True
                color: 0.2, 0.85, 1, 1
            Label:
                id: total_label
                text: "0 records"
                size_hint_x: None
                width: dp(100)
                font_size: sp(14)
                color: 0.6, 0.6, 0.7, 1

        # Search Bar
        TextInput:
            hint_text: "Search serial number or notes..."
            size_hint_y: None
            height: dp(45)
            multiline: False
            write_tab: False
            background_color: 0.15, 0.16, 0.22, 1
            foreground_color: 1, 1, 1, 1
            on_text_validate: app.search_history(self.text)

        # History List
        ScrollView:
            BoxLayout:
                id: history_list
                orientation: 'vertical'
                size_hint_y: None
                height: self.minimum_height
                spacing: dp(10)
